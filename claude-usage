<script>
const WINDOW_LABELS = ${JSON.stringify(WINDOW_LABELS)};
const WINDOW_ORDER = ${JSON.stringify(WINDOW_ORDER)};
const LIMIT_KIND_LABELS = ${JSON.stringify(LIMIT_KIND_LABELS)};
${windowsOf.toString()}

const el = (tag, cls, text) => {
  const n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text !== undefined) n.textContent = text;
  return n;
};
const statusVar = (p) => p >= 85 ? 'var(--critical)' : p >= 60 ? 'var(--warning)' : 'var(--good)';

function fmtRel(ms) {
  const mins = Math.round(ms / 60e3), hrs = Math.round(ms / 3600e3);
  if (ms <= 0) return 'now';
  if (mins < 60) return mins + 'm';
  if (hrs < 48) return Math.floor(mins / 60) + 'h ' + (mins % 60) + 'm';
  return Math.floor(hrs / 24) + 'd ' + (hrs % 24) + 'h';
}
function fmtResets(iso) {
  if (!iso) return '';
  const t = new Date(iso);
  if (isNaN(t)) return String(iso);
  const abs = t.toLocaleString(undefined, { weekday: 'short', hour: '2-digit', minute: '2-digit' });
  return 'resets in ' + fmtRel(t - Date.now()) + ' (' + abs + ')';
}
const fmtAge = (ms) => (ms < 120e3 ? Math.round(ms / 1000) + 's' : fmtRel(ms));

function renderAccounts(result) {
  const root = document.getElementById('accounts');
  root.replaceChildren();
  if (!result.accounts || !result.accounts.length) {
    root.append(el('div', 'empty',
      'No accounts stored — run claude-usage in a terminal to log in.'));
    return;
  }
  for (const acct of result.accounts) {
    const card = el('div', 'card');
    const head = el('div', 'card-head');
    head.append(el('span', 'label', acct.label));
    if (acct.identity) head.append(el('span', 'who', acct.identity));
    if (acct.lastSessionAt) {
      const ms = Math.max(0, Date.now() - new Date(acct.lastSessionAt));
      if (ms < ${ACTIVE_WINDOW_MS}) {
        head.append(el('span', 'badge', 'active'));
        head.append(el('span', 'sess', fmtAge(ms) + ' ago'));
      } else {
        head.append(el('span', 'sess', 'last session ' + fmtAge(ms) + ' ago'));
      }
    }
    if (acct.cachedMs) {
      const age = acct.cachedMs < 120e3 ? Math.round(acct.cachedMs / 1000) + 's' : fmtRel(acct.cachedMs);
      head.append(el('span', 'age', 'cached ' + age + ' ago'));
    }
    card.append(head);
    if (acct.stale) {
      const w = el('div', 'warnline');
      w.append(el('span', 'icon', '⚠ '),
        document.createTextNode('refresh failed (' + acct.stale + ') — showing last known data'));
      card.append(w);
    }
    if (acct.data.__error) {
      const w = el('div', 'warnline');
      w.append(el('span', 'icon', '⚠ '), document.createTextNode(acct.data.__error));
      card.append(w);
    } else {
      const wins = windowsOf(acct.data);
      if (!wins.length) card.append(el('div', 'empty', 'no usage windows in response'));
      for (const w of wins) {
        const row = el('div', 'meter');
        row.append(el('span', 'win', w.label));
        const track = el('div', 'track');
        const fill = el('div', 'fill');
        const pct = Math.max(0, Math.min(100, w.utilization));
        fill.style.width = pct + '%';
        fill.style.background = statusVar(pct);
        track.append(fill);
        row.append(track);
        row.append(el('span', 'pct', Math.round(pct) + '%'));
        row.append(el('span', 'resets', fmtResets(w.resets_at)));
        card.append(row);
      }
      const xu = acct.data.extra_usage;
      if (xu && typeof xu === 'object') {
        if (xu.is_enabled) {
          const dp = typeof xu.decimal_places === 'number' ? xu.decimal_places : 2;
          const money = (c) => (c / Math.pow(10, dp)).toFixed(dp) + (xu.currency ? ' ' + xu.currency : '');
          const row = el('div', 'meter');
          row.append(el('span', 'win', 'Extra usage (month)'));
          const track = el('div', 'track');
          const fill = el('div', 'fill');
          const pct = Math.max(0, Math.min(100, xu.utilization || 0));
          fill.style.width = pct + '%';
          fill.style.background = statusVar(pct);
          track.append(fill);
          row.append(track);
          row.append(el('span', 'pct', Math.round(pct) + '%'));
          row.append(el('span', 'resets',
            xu.used_credits != null && xu.monthly_limit != null
              ? money(xu.used_credits) + ' of ' + money(xu.monthly_limit) : ''));
          card.append(row);
        } else {
          const why = xu.disabled_reason || (xu.user_disabled ? 'user_disabled' : '');
          card.append(el('div', 'warnline', 'Extra usage: off' + (why ? ' (' + why + ')' : '')));
        }
      }
    }
    root.append(card);
  }
  document.getElementById('updated').textContent =
    'updated ' + new Date().toLocaleTimeString();
}

function renderSessions(result) {
  const root = document.getElementById('sessions');
  root.replaceChildren();
  if (!result.sessions || !result.sessions.length) {
    root.append(el('div', 'empty', 'No running Claude Code sessions found.'));
    return;
  }
  const table = el('table');
  const thead = el('thead'); const hr = el('tr');
  for (const h of ['PID', 'Config', 'Account', 'Project', 'Last active', 'Up']) hr.append(el('th', null, h));
  thead.append(hr); table.append(thead);
  const tbody = el('tbody');
  for (const s of result.sessions) {
    const tr = el('tr');
    tr.append(el('td', 'num', String(s.pid)));
    const cfg = el('td'); cfg.append(el('span', 'cfg', s.configDir || '')); tr.append(cfg);
    tr.append(el('td', null, s.account
      ? [s.account.email, s.account.org].filter(Boolean).join(' · ') : 'unknown'));
    tr.append(el('td', null, s.cwd || '–'));
    const last = el('td', 'num');
    const idleMs = s.lastActiveAt ? Math.max(0, Date.now() - new Date(s.lastActiveAt)) : null;
    if (idleMs === null) {
      last.append(el('span', 'idle', '–'));
    } else if (idleMs < ${ACTIVE_WINDOW_MS}) {
      last.append(el('span', 'badge', 'active'));
      last.append(el('span', 'idle', ' · ' + fmtAge(idleMs) + ' ago'));
    } else {
      last.append(el('span', 'idle', fmtAge(idleMs) + ' ago'));
    }
    tr.append(last);
    tr.append(el('td', 'num', s.startedAt ? fmtRel(Date.now() - new Date(s.startedAt)) : ''));
    tbody.append(tr);
  }
  table.append(tbody);
  root.append(table);
}

const DEMO = new URLSearchParams(location.search).has('demo');
const state = { usage: null, sessions: null };

// sessions refresh every 15s while usage every ~3min — re-join on the client so
// the "active" badge tracks the fresher of the two
function joinActivity() {
  if (DEMO || !state.usage || !state.sessions) return;
  for (const a of state.usage.accounts || []) {
    const email = (a.email || '').toLowerCase();
    if (!email) continue;
    let latest = null;
    for (const s of state.sessions.sessions || []) {
      if (!s.account || !s.lastActiveAt) continue;
      if ((s.account.email || '').toLowerCase() !== email) continue;
      if (a.org && s.account.org && s.account.org !== a.org) continue;
      if (!latest || s.lastActiveAt > latest) latest = s.lastActiveAt;
    }
    a.lastSessionAt = latest;
  }
}

async function loadUsage(fresh) {
  try {
    const r = await fetch('/api/usage' + (DEMO ? '?demo=1' : fresh ? '?fresh=1' : ''));
    state.usage = await r.json();
    joinActivity();
    renderAccounts(state.usage);
  } catch (e) {
    document.getElementById('accounts').replaceChildren(
      el('div', 'empty', 'failed to load usage: ' + e.message));
  }
}
async function loadSessions() {
  try {
    const r = await fetch('/api/sessions');
    state.sessions = await r.json();
    renderSessions(state.sessions);
    if (state.usage) { joinActivity(); renderAccounts(state.usage); }
  } catch (e) {
    document.getElementById('sessions').replaceChildren(
      el('div', 'empty', 'failed to load sessions: ' + e.message));
  }
}

document.getElementById('refresh').addEventListener('click', async (ev) => {
  const b = ev.currentTarget;
  b.disabled = true;
  await Promise.all([loadUsage(true), loadSessions()]);
  setTimeout(() => { b.disabled = false; }, 15000); // respect the endpoint's rate limit
});

loadUsage(false);
loadSessions();
setInterval(() => loadUsage(false), 180000); // ~3 min: the safe polling interval
setInterval(loadSessions, 15000);
</script>
