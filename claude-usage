(async () => {
  const argv = process.argv.slice(2);
  const flags = new Set(argv.filter((a) => a.startsWith('-')));
  const [cmd, arg] = argv.filter((a) => !a.startsWith('-'));
  if (flags.has('--help') || flags.has('-h')) return help();
  if (flags.has('--demo')) return cmdDemo();
  switch (cmd) {
    case undefined:
      return cmdShow({ json: flags.has('--json'), fresh: flags.has('--fresh') });
    case 'login': return cmdLogin(arg);
    case 'remove': return cmdRemove(arg);
    case 'list': return cmdList();
    case 'sessions': return cmdSessions();
    case 'serve': return cmdServe(arg);
    case 'help': return help();
    default:
      console.error(`unknown command: ${cmd}\n`);
      help();
      process.exit(1);
  }
})().catch((e) => {
  console.error(red(`error: ${e.message}`));
  process.exit(1);
});
